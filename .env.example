# Base URL of your deployed Cloudflare Worker API (leave empty during local preview)
# Example: https://rs-setups-api.your-subdomain.workers.dev
VITE_API_BASE_URL=""

# Subpath used when deploying to GitHub Pages (e.g. /rs-setups/)
# Leave as "/" for local dev or root domain hosting
VITE_BASE_PATH="/"

# Optional Cloudflare Worker secret (configure via `wrangler secret put SESSION_SECRET`)
# SESSION_SECRET="generate-a-long-random-hex-string"
